{
  "name": "open-loop",
  "private": true,
  "version": "0.1.0",
  "description": "Mark up any web page, capture rich bug context, and hand it to an AI coding agent over MCP.",
  "license": "AGPL-3.0-only",
  "author": "Ryan Woltz",
  "homepage": "https://github.com/ryanwoltz/open-loop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanwoltz/open-loop.git"
  },
  "bugs": {
    "url": "https://github.com/ryanwoltz/open-loop/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chrome-extension",
    "bug-report",
    "annotation",
    "claude-code",
    "ai-agent",
    "devtools"
  ],
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm build && playwright test",
    "serve": "node packages/server/dist/cli.js serve",
    "mcp": "node packages/server/dist/cli.js mcp"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
